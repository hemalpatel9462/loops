{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loops.game/schemas/app-settings.schema.json",
  "title": "Loops App Settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultMode", "reducedMotion", "lineThickness", "haptics", "tutorialCompleted"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "defaultMode": { "enum": ["relaxed", "assisted"] },
    "reducedMotion": { "type": "boolean" },
    "lineThickness": { "enum": ["thin", "standard", "thick"] },
    "haptics": { "type": "boolean" },
    "sound": { "type": "boolean", "default": true },
    "tutorialCompleted": { "type": "boolean" },
    "locale": { "type": "string", "minLength": 2 }
  }
}
